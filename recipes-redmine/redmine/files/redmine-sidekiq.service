[Unit]
Description=Redmine Sidekiq worker
Wants=network-online.target
After=network-online.target valkey.service redmine-storage-prepare.service redmine.service
Requires=redmine.service valkey.service redmine-storage-prepare.service
PartOf=redmine.service
RequiresMountsFor=/data

[Service]
Type=notify
NotifyAccess=all
User=redmine
Group=redmine
WorkingDirectory=/opt/redmine
EnvironmentFile=-/etc/default/redmine
RuntimeDirectory=redmine-sidekiq
ExecStart=/usr/bin/sidekiq --environment production --require /opt/redmine --queue default --queue mailers
Restart=on-failure
WatchdogSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/redmine /data/log/redmine /run/redmine-sidekiq
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
