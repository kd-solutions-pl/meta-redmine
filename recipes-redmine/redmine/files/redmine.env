RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
REDMINE_LANG=en
REDMINE_HOME=@REDMINE_HOME@
HOME=@REDMINE_WRITABLE_DIR@
GEM_HOME=/usr/lib/ruby/gems
GEM_PATH=/usr/lib/ruby/gems:/usr/lib/ruby/gems/4.0.0
REDMINE_SKIP_DEVELOPMENT_TEST_GEMS=1
REDMINE_WRITABLE_DIR=@REDMINE_WRITABLE_DIR@
REDMINE_LOG_DIR=@REDMINE_LOG_DIR@
REDIS_URL=redis://127.0.0.1:6379/0
REDMINE_SSL_KEY=@REDMINE_WRITABLE_DIR@/config/ssl/redmine.key
REDMINE_SSL_CERT=@REDMINE_WRITABLE_DIR@/config/ssl/redmine.crt
