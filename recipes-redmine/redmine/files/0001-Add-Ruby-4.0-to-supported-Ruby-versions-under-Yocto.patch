From f3e18ebbf013c59bd8639a6c39eabbe07285871c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Krzysztof=20Drobi=C5=84ski?= <krzysztof@kd-solutions.pl>
Date: Wed, 13 May 2026 10:58:36 +0200
Subject: [PATCH] Add Ruby 4.0 to supported Ruby versions under Yocto

Upstream-Status: Pending
---
 Gemfile        | 12 ++++++++----
 config/boot.rb |  2 ++
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/Gemfile b/Gemfile
index b4099e7e1..a923cd8c4 100644
--- a/Gemfile
+++ b/Gemfile
@@ -1,8 +1,10 @@
 source 'https://rubygems.org'
 
-ruby '>= 3.2.0', '< 3.5.0'
+ruby '>= 3.2.0', '< 4.1.0'
 
 gem 'rails', '7.2.3.1'
+gem 'puma', '~> 8.0.1'
+gem 'ostruct', '~> 0.6.3'
 gem 'rouge', '~> 4.5'
 gem 'mini_mime', '~> 1.1.0'
 gem "actionpack-xml_parser"
@@ -18,7 +20,7 @@ gem 'propshaft', '~> 1.1.0'
 gem 'rack', '>= 3.1.3'
 gem "stimulus-rails", "~> 1.3"
 gem "importmap-rails", "~> 2.0"
-gem 'commonmarker', '~> 2.3.0'
+gem 'commonmarker', '~> 2.8.2'
 gem "doorkeeper", "~> 5.8.2"
 gem "bcrypt", require: false
 gem "doorkeeper-i18n", "~> 5.2"
@@ -26,7 +28,7 @@ gem "requestjs-rails", "~> 0.0.13"
 
 #  Ruby Standard Gems
 gem 'csv', '~> 3.3.2'
-gem 'net-imap', '~> 0.5.7'
+gem 'net-imap', '~> 0.6.4'
 gem 'net-pop', '~> 0.1.2'
 gem 'net-smtp', '~> 0.5.0'
 
@@ -94,6 +96,7 @@ else
   warn("Please configure your config/database.yml first")
 end
 
+unless ENV["REDMINE_SKIP_DEVELOPMENT_TEST_GEMS"] == "1"
 group :development, :test do
   gem 'debug'
 end
@@ -111,7 +114,6 @@ group :test do
   gem 'simplecov', '~> 0.22.0', :require => false
   gem "ffi", platforms: [:mingw, :x64_mingw, :mswin]
   # For running system tests
-  gem 'puma'
   gem "capybara", ">= 3.39"
   gem 'selenium-webdriver', '>= 4.11.0'
   # RuboCop
@@ -126,6 +128,7 @@ group :test do
   gem 'minitest', '~> 5.27'
 end
 
+end
 local_gemfile = File.join(File.dirname(__FILE__), "Gemfile.local")
 if File.exist?(local_gemfile)
   eval_gemfile local_gemfile
diff --git a/config/boot.rb b/config/boot.rb
index e7d68c4ad..b299a2703 100644
--- a/config/boot.rb
+++ b/config/boot.rb
@@ -19,4 +19,6 @@ ENV['RACK_QUERY_PARSER_PARAMS_LIMIT'] ||= '65536'
 # Set up gems listed in the Gemfile.
 ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../Gemfile', __FILE__)
 
+require 'rubygems'
+require 'error_highlight/version'
 require 'bundler/setup' if File.exist?(ENV['BUNDLE_GEMFILE'])
-- 
2.51.0
