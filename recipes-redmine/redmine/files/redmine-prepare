#!/bin/sh
set -eu

. /etc/default/redmine

RAILS="${REDMINE_HOME}/bin/rails"
PACKAGED_VERSION_FILE="/usr/share/redmine/version"
INSTALLED_VERSION_FILE="${REDMINE_WRITABLE_DIR}/.installed-version"

roles_table_exists() {
    /usr/bin/ruby "${RAILS}" runner '
        connection = ActiveRecord::Base.connection
        unless connection.data_source_exists?("roles")
          warn "Redmine database does not contain roles table"
          warn "Configured database: #{ActiveRecord::Base.connection_db_config.database}"
          warn "Existing tables: #{connection.data_sources.sort.join(", ")}"
          exit 1
        end
    '
}

database_is_empty() {
    /usr/bin/ruby "${RAILS}" runner '
        connection = ActiveRecord::Base.connection
        exit(connection.data_source_exists?("roles") ? 1 : 0)
    '
}

clear_asset_data() {
    for directory in \
        "${REDMINE_WRITABLE_DIR}/public/assets" \
        "${REDMINE_WRITABLE_DIR}/tmp/cache"; do
        [ -d "${directory}" ] || continue
        find "${directory}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
    done
}

ensure_assets_current() {
    packaged_version="$(cat "${PACKAGED_VERSION_FILE}")"
    installed_version=""
    if [ -s "${INSTALLED_VERSION_FILE}" ]; then
        installed_version="$(cat "${INSTALLED_VERSION_FILE}")"
    fi

    if [ "${installed_version}" = "${packaged_version}" ] && \
       [ -e "${REDMINE_WRITABLE_DIR}/public/assets/.manifest.json" ]; then
        return 0
    fi

    echo "Preparing Redmine assets for version ${packaged_version}"
    clear_asset_data
    /usr/bin/ruby "${RAILS}" tmp:cache:clear
    /usr/bin/ruby "${RAILS}" assets:precompile

    installed_version_tmp="${INSTALLED_VERSION_FILE}.tmp.$$"
    printf '%s\n' "${packaged_version}" >"${installed_version_tmp}"
    mv "${installed_version_tmp}" "${INSTALLED_VERSION_FILE}"
}

if [ ! -x "${RAILS}" ]; then
    echo "Missing Redmine Rails launcher: ${RAILS}" >&2
    exit 1
fi

if [ -s "${REDMINE_HOME}/Gemfile.lock.dist" ]; then
    if [ ! -s "${REDMINE_WRITABLE_DIR}/Gemfile.lock" ]; then
        cp -a "${REDMINE_HOME}/Gemfile.lock.dist" "${REDMINE_WRITABLE_DIR}/Gemfile.lock"
    elif ! cmp -s "${REDMINE_HOME}/Gemfile.lock.dist" "${REDMINE_WRITABLE_DIR}/Gemfile.lock"; then
        stale_lock="${REDMINE_WRITABLE_DIR}/Gemfile.lock.stale-$(date +%Y%m%d%H%M%S)"
        mv "${REDMINE_WRITABLE_DIR}/Gemfile.lock" "${stale_lock}"
        cp -a "${REDMINE_HOME}/Gemfile.lock.dist" "${REDMINE_WRITABLE_DIR}/Gemfile.lock"
        echo "Replaced stale Redmine Gemfile.lock with packaged lockfile; old lockfile saved as ${stale_lock}" >&2
    fi
fi

cd "${REDMINE_HOME}"

if [ ! -s config/initializers/secret_token.rb ]; then
    /usr/bin/ruby "${RAILS}" generate_secret_token
fi

DB_NEEDS_DEFAULTS=0
if database_is_empty; then
    DB_NEEDS_DEFAULTS=1
fi

/usr/bin/ruby "${RAILS}" db:migrate

if ! roles_table_exists; then
    echo "Redmine database schema is incomplete: roles table is missing" >&2
    exit 1
fi

if [ "${DB_NEEDS_DEFAULTS}" -eq 1 ]; then
    /usr/bin/ruby "${RAILS}" redmine:load_default_data
fi

ensure_assets_current
